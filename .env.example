# ==============================================================================
# 🦂 LA CRAIA AUTOMOTIVE ECOSYSTEM - CONFIGURAÇÃO DE AMBIENTE (.env)
# Copie este arquivo para .env e customize conforme necessário:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SEGURANÇA & CONTROLE DE CABINES (RBAC)
# ------------------------------------------------------------------------------
# Chave mestra universal para administração global de cabines.
# Permite criar cabines, entrar como piloto em qualquer cabine e rotacionar chaves.
# Padrão de fallback: lacraia_master_2011
LACRAIA_MASTER_KEY=lacraia_master_2011

# ------------------------------------------------------------------------------
# 2. CATÁLOGO & GRAFO DE SIMILARIDADE ACÚSTICA (LAST.FM & MUSICBRAINZ)
# ------------------------------------------------------------------------------
# Chave de API do Last.fm para enriquecimento de catálogo e rádio de similaridade.
# Obtenha gratuitamente em: https://www.last.fm/api/account/create
# (Se não definida, o sistema usa automaticamente o MusicBrainz que é 100% aberto e sem chave).
LASTFM_API_KEY=

# ------------------------------------------------------------------------------
# 3. REDE & PORTAS DO SERVIDOR UNIFICADO (DAEMON + COCKPIT WEB)
# ------------------------------------------------------------------------------
# Porta de escuta HTTP/WebSocket do daemon lacraia-core
# (start.sh usa 8080 por padrão; dev.sh usa 2011)
PORT=2011

# Endereço de bind de rede (0.0.0.0 escuta em todas as interfaces)
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 4. ARMAZENAMENTO LOCAL & CACHE DE ÁUDIO OPUS
# ------------------------------------------------------------------------------
# Caminho para o banco de dados SQLite local
LACRAIA_DB_PATH=./lacraia.sqlite

# Diretório para armazenamento dos arquivos de áudio .opus resolvidos e cacheados
LACRAIA_CACHE_DIR=./cache

# Diretório de arquivos estáticos do cockpit web e portal
LACRAIA_SITE_DIR=./site

# ------------------------------------------------------------------------------
# 5. BINÁRIOS DE EXTRAÇÃO DE MÍDIA (OPCIONAL)
# ------------------------------------------------------------------------------
# Caminho customizado para o yt-dlp (se não especificado, busca no PATH do sistema)
# YTDLP_BIN=/usr/local/bin/yt-dlp

# Caminho customizado para o ffmpeg (se não especificado, busca no PATH do sistema)
# FFMPEG_BIN=/usr/bin/ffmpeg
